<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+).
     The foreground currently reuses the legacy ic_launcher PNG as a
     placeholder so the build keeps working. To drop in the final Docvera
     logo: replace the foreground source below with @mipmap/ic_launcher_foreground
     (a 108x108dp layer with content in the center 66x66dp safe zone) and set
     @color/ic_launcher_background to the Docvera brand color. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher"/>
</adaptive-icon>
